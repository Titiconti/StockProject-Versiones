# Copiá este archivo como ".env" y completalo. El .env NO se sube al repositorio.

# Dominio base: cada comercio entra por <sub>.<DOMAIN_BASE>
DOMAIN_BASE=stockproject.qd.je

# Token de administración (alta y baja de comercios). Generá uno largo con:  openssl rand -hex 32
# Con el valor "cambiar" el servidor no arranca.
ADMIN_TOKEN=cambiar
