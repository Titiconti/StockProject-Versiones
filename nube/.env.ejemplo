# Copiá este archivo como ".env" y completalo. El .env NO se sube al repositorio.

# Solo para una VM propia con dominio propio: cada comercio entra por <sub>.<DOMAIN_BASE>.
# En Vercel no hace falta (los comercios entran por https://stockprojectapp.vercel.app/c/<comercio>).
DOMAIN_BASE=tudominio.com

# Token de administración (alta y baja de comercios). Generá uno largo con:  openssl rand -hex 32
# Con el valor "cambiar" el servidor no arranca.
ADMIN_TOKEN=cambiar
