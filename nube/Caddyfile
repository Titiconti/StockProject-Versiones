# Caddy pide un certificado la primera vez que alguien entra a un dominio ("on-demand TLS"),
# pero solo si el servidor confirma que es el dominio base o el de un comercio activo.
{
	on_demand_tls {
		ask http://nube:8080/interno/tls-permitido
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	# Las rutas internas no se exponen a internet.
	@interno path /interno /interno/*
	respond @interno 404

	reverse_proxy nube:8080
}
