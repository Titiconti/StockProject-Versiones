{
  "name": "stockproject",
  "productName": "StockProject",
  "version": "2.1.1",
  "description": "StockProject - Punto de venta e inventario",
  "author": "StockProject",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node tests/run.js",
    "servidor": "node servidor-cli.js"
  },
  "build": {
    "appId": "com.stockproject.app",
    "productName": "StockProject",
    "files": [
      "main.js",
      "actualizador.js",
      "preload.js",
      "store.js",
      "validar.js",
      "usuarios.js",
      "integraciones.js",
      "empresas.js",
      "monedas.js",
      "api.js",
      "login.html",
      "clave.html",
      "servidor.js",
      "servidor-cli.js",
      "index.html",
      "defaults.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "3082",
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Titiconti",
        "repo": "StockProject-Versiones",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Titiconti/StockProject-Versiones.git"
  }
}
