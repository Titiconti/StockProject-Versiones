{
  "name": "stockproject",
  "productName": "StockProject",
  "version": "5.7.1",
  "description": "StockProject - Punto de venta e inventario",
  "author": "StockProject",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node tests/run.js"
  },
  "build": {
    "appId": "com.stockproject.app",
    "productName": "StockProject",
    "files": [
      "main.js",
      "actualizador.js",
      "preload.js",
      "store.js",
      "validar.js",
      "permisos-datos.js",
      "nube.js",
      "xlsx-lector.js",
      "mercadopago.js",
      "arca.js",
      "arca-ws.js",
      "precios-remoto.js",
      "usuarios.js",
      "empresas.js",
      "monedas.js",
      "login.html",
      "clave.html",
      "fonts/chivo-latin-wght-normal.woff2",
      "index.html",
      "defaults.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "3082",
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Titiconti",
        "repo": "StockProject-Versiones",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "node-forge": "^1.4.3",
    "qrcode-generator": "^2.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Titiconti/StockProject-Versiones.git"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
