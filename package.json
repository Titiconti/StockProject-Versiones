{
  "name": "stockproject",
  "productName": "StockProject",
  "version": "1.7.3",
  "description": "StockProject - Punto de venta e inventario",
  "author": "StockProject",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node tests/run.js",
    "servidor": "node servidor-cli.js"
  },
  "build": {
    "appId": "com.stockproject.app",
    "productName": "StockProject",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "servidor.js",
      "servidor-cli.js",
      "index.html",
      "defaults.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "3082",
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
